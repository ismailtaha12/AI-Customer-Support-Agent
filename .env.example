# --- Server ---
PORT=3000
ADMIN_API_KEY=change-me            # protects /ingest and /usage endpoints

# --- Supabase (Project Settings > API) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=         # server only, never ship to a client

# --- OpenAI ---
OPENAI_API_KEY=
CHAT_MODEL=gpt-4o                  # "smart" tier: final answers
FAST_MODEL=gpt-4o-mini             # "fast" tier: classify / rewrite / grade / guards
EMBEDDING_MODEL=text-embedding-3-small   # 1536 dims, must match the vector(1536) columns

# --- Feature flags (flip these to A/B in the eval) ---
CONTEXTUAL_RETRIEVAL=true          # add an LLM-written context blurb to each chunk at ingest
LLM_INPUT_GUARD=true               # LLM-based prompt-injection check (heuristics always run)
SEMANTIC_CACHE=true
CACHE_SIMILARITY_THRESHOLD=0.95
CACHE_TTL_HOURS=24

DEMO_MODE=true                     # lets guests seed fake appointments (turn off in real deployments)

# --- Vector store: pgvector (default) or chroma ---
VECTOR_STORE=pgvector
CHROMA_URL=                        # e.g. http://localhost:8000 (optional, used by the eval comparison)

# --- LangSmith tracing (picked up automatically by LangGraph + the OpenAI wrapper) ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-support

