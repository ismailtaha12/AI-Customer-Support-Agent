{
  "name": "ai-support",
  "version": "0.1.0",
  "private": true,
  "description": "Small AI customer-support agent: NestJS + Supabase (pgvector) + LangGraph + LangSmith",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main",
    "start:dev": "nest start --watch",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "ingest": "ts-node scripts/ingest.ts",
    "token": "ts-node scripts/get-token.ts",
    "eval": "ts-node evals/run-eval.ts"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": "test/.*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "diagnostics": false
        }
      ]
    },
    "testEnvironment": "node"
  },
  "dependencies": {
    "@langchain/core": "^1.3.5",
    "@langchain/langgraph": "^1.7.2",
    "@nestjs/common": "^11.2.8",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.8",
    "@nestjs/platform-express": "^11.2.8",
    "@supabase/supabase-js": "^2.119.0",
    "chromadb": "^3.5.0",
    "dotenv": "^18.0.10",
    "langsmith": "^0.11.8",
    "openai": "^5.23.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.8",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "~5.9"
  }
}
